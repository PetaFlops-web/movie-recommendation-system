# Local Development Environment Variables
# Copy this file to .env.local and fill with your local values

# Database (Local PostgreSQL)
DB_USER=pijak_user
DB_PASSWORD=pijak_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pijak_db
DATABASE_URL=postgresql://pijak_user:pijak_password@localhost:5432/pijak_db

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=dev_secret_key_not_for_production_minimum_32_characters_recommended

# Services URLs
FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=http://localhost:5000

# Python Service
FLASK_ENV=development
FLASK_PORT=5000

# Optional
LOG_LEVEL=debug

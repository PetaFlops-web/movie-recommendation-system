# FLASK CONFIGURATION
FLASK_ENV=production
FLASK_PORT=5000
FLASK_DEBUG=False

# MODEL CONFIGURATION
MODEL_PATH=./model/
USE_GPU=false
BATCH_SIZE=32
NUM_WORKERS=4

# EXTERNAL SERVICES
BACKEND_URL=http://backend:3000

# LOGGING
LOG_LEVEL=INFO

# MEMORY & PERFORMANCE
MAX_CONTENT_LENGTH=50000000
TIMEOUT=300

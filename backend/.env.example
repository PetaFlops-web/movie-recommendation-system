# ===== RATE LIMITING (Optional) =====
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# ===== LOGGING (Optional) =====
LOG_LEVEL=info
SENTRY_DSN=

# ===== CORS Configuration =====
CORS_ORIGIN=https://your-frontend.vercel.app,https://www.your-domain.com

# Backend Environment Variables Template
# Copy this file to .env and fill in the actual values

# ===== DATABASE =====
DATABASE_URL=postgresql://postgres:SEpBpUlgJRJHmvgwsrtbGqjBqgiuUXaf@acela.proxy.rlwy.net:27721/railway

# ===== SERVER CONFIGURATION =====
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ===== AUTHENTICATION =====
JWT_SECRET=your_very_secure_secret_key_here_minimum_32_chars_recommended
JWT_EXPIRES_IN=7d

# ===== EXTERNAL SERVICES =====
PYTHON_SERVICE_URL=http://python-service:5000

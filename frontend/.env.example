# Frontend Environment Variables Template
# Create .env.local for local development
# Create .env.production.local for production builds

# ===== API CONFIGURATION =====
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
NEXT_PUBLIC_PYTHON_API_URL=https://your-python-service.railway.app
NEXT_PUBLIC_API_TIMEOUT=30000

# ===== AUTHENTICATION =====
NEXT_PUBLIC_JWT_STORAGE_KEY=auth_token_storage

# ===== FEATURE FLAGS =====
NEXT_PUBLIC_ENABLE_CF=true
NEXT_PUBLIC_ENABLE_CBF=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===== LOGGING =====
NEXT_PUBLIC_LOG_LEVEL=info

# ===== APP CONFIG =====
NEXT_PUBLIC_APP_NAME=Smart Movie Recommendation
NEXT_PUBLIC_APP_VERSION=1.0.0

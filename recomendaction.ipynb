        "df_rf['reviewer_encoded'] = le_user.fit_transform(df_rf['reviewer'])\n",
        "df_rf['movie_encoded'] = le_movie.fit_transform(df_rf['movie'])\n",
        "\n",
        "# Tentukan Fitur (X) dan Target (y)\n",
        "X = df_rf[['reviewer_encoded', 'movie_encoded']]\n",
        "y = df_rf['rating']\n",
